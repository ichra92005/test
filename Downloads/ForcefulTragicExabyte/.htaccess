
# ============================================================
# منصّة زاد الكشفية للقرآن — إعدادات Apache (InfinityFree / cPanel / shared hosting)
# ============================================================

# فعِّل محرّك إعادة الكتابة
RewriteEngine On
RewriteBase /

# الترميز الافتراضي UTF-8
AddDefaultCharset UTF-8

# تعطيل عرض محتوى المجلّدات
Options -Indexes -MultiViews

# فهرس افتراضي
DirectoryIndex index.php index.html

# ------------------------------------------------------------
# 1) إعادة كتابة جميع الطلبات نحو server.php
#    (مع استثناء الملفات والمجلّدات الموجودة فعلاً)
# ------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# كلّ شيء آخر يمرّ عبر الراوتر
RewriteRule ^(.*)$ server.php [QSA,L]

# ------------------------------------------------------------
# 2) كسر حلقة إعادة التوجيه على InfinityFree
#    InfinityFree يضع ErrorDocument 404 → /error/ على مستوى الخادم،
#    وهذا يُسبّب redirect loop. نُعطّله ونعتمد على راوترنا.
# ------------------------------------------------------------
ErrorDocument 400 https://zad-platform.is-best.net/error/
ErrorDocument 401 https://zad-platform.is-best.net/error/
ErrorDocument 403 https://zad-platform.is-best.net/error/
ErrorDocument 404 https://zad-platform.is-best.net/error/
ErrorDocument 500 https://zad-platform.is-best.net/error/
ErrorDocument 503 https://zad-platform.is-best.net/error/

# ------------------------------------------------------------
# 3) منع الوصول المباشر للملفات الحسّاسة
# ------------------------------------------------------------
<FilesMatch "\.(json|md|log|env|gitignore|lock|sql|bak|old|swp|ini)$">
    Require all denied
</FilesMatch>

# منع الوصول لملفات النظام
<FilesMatch "^(\.htaccess|\.htpasswd|\.git|composer\.(json|lock)|package(-lock)?\.json|replit\.md)$">
    Require all denied
</FilesMatch>

# منع الوصول المباشر لمجلّد قاعدة البيانات JSON
RewriteRule ^site/backend/database/.*$ - [F,L]

# منع الوصول المباشر لمجلّد الـ API (يجب أن يمرّ عبر /api/* )
RewriteRule ^site/backend/api/.*\.php$ - [F,L]

# منع الوصول لمجلّد .git
RewriteRule ^\.git/?.*$ - [F,L]

# ------------------------------------------------------------
# 4) ضغط الاستجابات (gzip) لتسريع الموقع
# ------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------
# 5) ذاكرة المتصفّح (Cache) للأصول الثابتة
# ------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css              "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png             "access plus 6 months"
    ExpiresByType image/jpg             "access plus 6 months"
    ExpiresByType image/jpeg            "access plus 6 months"
    ExpiresByType image/gif             "access plus 6 months"
    ExpiresByType image/svg+xml         "access plus 6 months"
    ExpiresByType image/x-icon          "access plus 1 year"
    ExpiresByType image/webp            "access plus 6 months"
    ExpiresByType font/woff             "access plus 1 year"
    ExpiresByType font/woff2            "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType text/html             "access plus 1 hour"
    ExpiresByType application/xml       "access plus 1 hour"
    ExpiresByType application/json      "no-cache"
</IfModule>

# ------------------------------------------------------------
# 6) ترويسات أمان أساسيّة
# ------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "no-referrer-when-downgrade"
    Header set X-XSS-Protection "1; mode=block"
    # حذف ترويسات تكشف معلومات الخادم
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# إخفاء معلومات PHP
<IfModule mod_php.c>
    php_flag expose_php Off
</IfModule>
